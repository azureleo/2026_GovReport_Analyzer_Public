# main 기반 V9 선별 이식. 기존 .env와 모델/provider/reasoning은 교체하지 마세요.
# 아래는 새 기능 설정만 설명합니다. 원본 main에는 .env.example이 없었습니다.
EXTRACTION_OBJECT_BATCHING_ENABLED=0
MAX_BATCH_CHARS=0
MAX_BATCH_TABLE_CELLS=0
TABLE_OBJECT_ROWS_PER_CHUNK=20
SELECTIVE_OCR_ENABLED=0
OCR_BACKEND=directory
OCR_RESULTS_DIR=
OCR_NATIVE_CONFIDENCE_THRESHOLD=0.78
# 표 대응과 교체 품질의 보조 기준; 검증된 최적값을 의미하지 않습니다.
OCR_OBJECT_MATCH_MIN_IOU=0.55
OCR_ALLOW_LEGACY_UNLOCATED=0
OCR_REPLACE_MIN_CELLS=2
OCR_REPLACE_CELL_RATIO=1.10
PROVENANCE_ENABLED=1
SEMANTIC_ROUTING_ENABLED=0
SEMANTIC_AUTO_RECLASSIFY=0
SEMANTIC_CONTRACT_GUARDS_ENABLED=0
RUN_STATE_ENABLED=0
RUN_STATE_DIR=.cache/run_state
EXTRACTION_RESUME=0
EXTRACTION_RETRY_FAILED_ONLY=0
# *_pipeline_audit.json은 RUN_STATE_ENABLED와 무관하게 Excel 옆에 저장됩니다.
# 기본 off. audit는 명시 표 항목과 실제 Excel의 대조 기록만 추가합니다.
# 라우팅/배치/프롬프트/모델/업무 셀은 변경하지 않고 재추출도 하지 않습니다.
SOURCE_COVERAGE_MODE=off
# 확정 예산 2차 판독은 scripts/run_second_pass.py의 명시 --execute로만 실행합니다.
# .env 활성화 스위치는 없으며 기본 dry-run입니다. 모델은 기준 run_manifest에서 읽습니다.
# 기본 4회/300초/호출당 90초, 누적 판독 시간은 기준 실행 시간의 20% 이내입니다.
# 상세 명령·재개·출력: docs/second_pass_runner.md
# 저장 후 규칙 검사는 추가 모델 호출/자동 재추출 없이 실제 Excel을 읽습니다.
QUALITY_REPORT_ENABLED=1
# auto: 원문 SHA가 일치하는 승인 골든만. off는 골든만 비활성, required도 Excel 보존.
EVALUATION_MODE=auto
# 공란은 data/evaluation/benchmark_manifest.json. 경로는 작업 디렉터리 기준.
EVALUATION_MANIFEST_PATH=
EVALUATION_DATASET_ID=
# 서울 골든은 아직 draft이므로 자동 승인하지 않습니다.
ALLOW_DRAFT_EVALUATION=0
EVALUATE_HOLDOUT=0
# 상태/산출물/CLI: docs/saved_quality_evaluation.md
