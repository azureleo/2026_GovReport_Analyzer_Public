# LLM backend: gemini / openai / codex / claude / auto
LLM_PROVIDER=gemini

# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional hybrid review:
# Use GPT/OpenAI as the primary extractor, then use Gemini only for targeted review candidates.
HYBRID_REVIEW_ENABLED=0
HYBRID_REVIEW_PROVIDER=gemini
HYBRID_REVIEW_MODEL=gemini-2.5-flash-lite
HYBRID_REVIEW_MAX_BATCHES_PER_SHEET=2
HYBRID_SHEETWISE_FLOW_ENABLED=1
HYBRID_PROGRESS_LOG_ENABLED=1
HYBRID_ADJUDICATION_ENABLED=1
HYBRID_ADJUDICATION_PROVIDER=gemini
HYBRID_ADJUDICATION_MODEL=gemini-2.5-pro
HYBRID_ADJUDICATION_MAX_CANDIDATES=0
HYBRID_ADJUDICATION_BATCH_SIZE=6
HYBRID_ADJUDICATION_CONTEXT_CHARS=8000
HYBRID_AUTO_MERGE_ENABLED=0
HYBRID_AUTO_MERGE_MIN_CONFIDENCE=high
# Local CLI backends also work for hybrid review/adjudication when installed:
# HYBRID_REVIEW_PROVIDER=codex
# HYBRID_ADJUDICATION_PROVIDER=claude

# Parallel processing
# 추출(시트×배치)·이미지 vision 호출을 동시에 실행한다(프롬프트·응답 동일 → 결과 불변,
# 벽시계 시간만 단축). 0으로 두면 순차 실행으로 폴백.
PARALLEL_PROCESSING_ENABLED=1
TEXT_WORKERS=4
VISION_WORKERS=2

# Document and image batching
BATCH_SIZE=15
IMAGE_ANALYSIS_BATCH_SIZE=8
# A timed-out text batch is retried once, then recursively split into smaller page groups.
LOCAL_AGENT_TIMEOUT_RETRIES=1
LOCAL_AGENT_TIMEOUT_RETRY_DELAY_SECONDS=5
EXTRACTION_SPLIT_ON_TIMEOUT=1
EXTRACTION_TIMEOUT_MIN_BATCH_PAGES=2
EXTRACTION_TIMEOUT_MAX_SPLIT_DEPTH=6
EXTRACTION_TIMEOUT_RECOVERY_BUDGET_SECONDS=900
# 타임아웃뿐 아니라 API 호출 실패·JSON 파싱 실패도 더 작은 배치로 분할 복구한다.
EXTRACTION_SPLIT_ON_FAILURE=1
# 호출 전 큰 입력을 분할하고, 단일 페이지의 표는 헤더 반복 행 청크로 우선 복구한다.
EXTRACTION_MAX_BATCH_CHARS=18000
EXTRACTION_RECOVERY_MAX_BATCH_CHARS=12000
EXTRACTION_TABLE_ROWS_PER_BATCH=20

# 재현성·중단 복구. CLI의 --resume/--retry-failed-only 사용을 권장한다.
RUN_STATE_ENABLED=1
RUN_STATE_DIR=.cache/runs
EXTRACTION_RESUME=0
EXTRACTION_RETRY_FAILED_ONLY=0
# 성공 체크포인트 중 선택 Vision 객체만 강제 재판독한다. 쉼표 구분.
VISION_RETRY_EVIDENCE_IDS=
VISION_RETRY_PAGES=

# 동일 입력의 출력 변동을 줄인다. 모델이 지원하지 않으면 공급자 기본값으로 처리될 수 있다.
LLM_TEMPERATURE=0

# Deterministic source verification and quality gate (no LLM calls)
SOURCE_VERIFICATION_ENABLED=1
SOURCE_VERIFICATION_PAGE_RADIUS=1
SOURCE_VERIFICATION_MAX_TERMS=12
SOURCE_VERIFICATION_GLOBAL_SEARCH=1
SOURCE_VERIFICATION_MARK_PDF=1
SOURCE_VERIFICATION_MAX_MARKS=10000
SOURCE_OBJECT_INVENTORY_ENABLED=1
SOURCE_OBJECT_PARTIAL_WEIGHT=0.5
SEMANTIC_ROUTING_ENABLED=1
SEMANTIC_ROUTING_AUTO_RECLASSIFY=1
SEMANTIC_ROUTING_MIN_SCORE=5
SEMANTIC_ROUTING_MIN_MARGIN=1.5
SEMANTIC_ROUTING_ALLOWED_SCORE_DELTA=1.5
SEMANTIC_ROUTING_MAX_ALLOWED_TARGETS=3
QUALITY_THRESHOLD=70
QUALITY_MAX_WITHOUT_SOURCE_INVENTORY=95

# Fixed development/holdout evaluation contract. Evaluation is only run with --evaluate.
EVALUATION_MANIFEST_PATH=data/evaluation/benchmark_manifest.json

# Vision 배치도 실행 원장에 저장하며 실패한 묶음은 이미지 단위까지 재귀 분할한다.
VISION_CHECKPOINT_ENABLED=1
VISION_SPLIT_ON_FAILURE=1
VISION_RECOVERY_MAX_SPLIT_DEPTH=6
VISION_RECOVERY_MAX_OBJECT_ATTEMPTS=7

# Object-first selective OCR/VLM.
# vlm: use the existing vision agent only for low-confidence objects.
# unlimited_ocr: import pre-generated Markdown/JSONL from OCR_RESULTS_DIR.
# none: keep native PyMuPDF objects without OCR supplementation.
SELECTIVE_OCR_ENABLED=1
VISUAL_EVIDENCE_MERGE_ENABLED=1
VISUAL_MERGE_SNAPSHOT_ENABLED=1
OCR_BACKEND=vlm
OCR_RESULTS_DIR=
OCR_NATIVE_CONFIDENCE_THRESHOLD=0.78
OCR_COMPLEX_TABLE_ROWS=45
OCR_COMPLEX_TABLE_COLUMNS=12
OCR_RENDER_DPI=200

# Gap-fill: 1차 추출이 이미 보낸 페이지를 빈칸보완 재추출에서 제외(중복 토큰 제거).
# 라우팅이 놓친 새 페이지만 재추출하므로 GapFill 본래 목적과 일치. 1이 기본.
GAP_FILL_SKIP_ALREADY_ROUTED=1

# Routing sharpening (strong): document_meta 같은 시트의 머리말 boilerplate strong
# 키워드 과편입을 줄여 토큰 절감. 단 정답지 기반 Check A로 리콜 무회귀를 증명하기
# 전에는 비활성(0). 검증:
#   python scripts/verify_routing_coverage.py <golden.xlsx> <source.pdf>
ROUTE_DROP_UBIQUITOUS_STRONG=0
ROUTE_STRONG_UBIQUITY_RATIO=0.6
# Fail closed if a detected prior-plan chapter has no next-chapter boundary within this span.
PRIOR_PLAN_MAX_PAGES=60

# Optional local agent settings
LOCAL_AGENT_MODEL=
# Codex 전용 기본값. STAGE_MODEL_* 또는 LOCAL_AGENT_MODEL이 있으면 그 값이 우선합니다.
CODEX_TEXT_MODEL=gpt-5.6-luna
CODEX_VISION_MODEL=gpt-5.6-luna
LOCAL_AGENT_TIMEOUT=300
CODEX_COMMAND=codex
CLAUDE_COMMAND=claude
