# LLM backend: gemini / openai / codex / claude / auto
LLM_PROVIDER=gemini

# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional hybrid review:
# Use GPT/OpenAI as the primary extractor, then use Gemini only for targeted review candidates.
HYBRID_REVIEW_ENABLED=0
HYBRID_REVIEW_PROVIDER=gemini
HYBRID_REVIEW_MODEL=gemini-2.5-flash-lite
HYBRID_REVIEW_MAX_BATCHES_PER_SHEET=2
HYBRID_ADJUDICATION_ENABLED=1
HYBRID_ADJUDICATION_PROVIDER=gemini
HYBRID_ADJUDICATION_MODEL=gemini-2.5-pro
HYBRID_ADJUDICATION_MAX_CANDIDATES=0
HYBRID_AUTO_MERGE_ENABLED=0
HYBRID_AUTO_MERGE_MIN_CONFIDENCE=high

# Parallel processing
PARALLEL_PROCESSING_ENABLED=1
TEXT_WORKERS=4
VISION_WORKERS=2
MAX_IN_FLIGHT_REQUESTS=6

# Document and image batching
BATCH_SIZE=15
IMAGE_ANALYSIS_BATCH_SIZE=8
GEMINI_VISION_BATCH_SIZE=1

# Optional local agent settings
LOCAL_AGENT_MODEL=
LOCAL_AGENT_TIMEOUT=900
CODEX_COMMAND=codex
CLAUDE_COMMAND=claude
